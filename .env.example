# Intellark — environment variable template
# Copy this to .env and fill in your values.
# Lines starting with # are comments and are ignored.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set exactly ONE provider key. The app auto-detects which model to use.
# Priority order: Grok > Anthropic > OpenAI > Gemini
#
# Gemini (free tier available):  https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# OpenAI:                        https://platform.openai.com → API keys
OPENAI_API_KEY=
# Anthropic:                     https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# xAI Grok:                      https://console.x.ai → API keys
GROK_API_KEY=
#
# Override the auto-detected model (optional):
BRAIN_LLM_MODEL=
# Override the synthesis model (optional — defaults to strongest available):
BRAIN_SYNTH_MODEL=

# ── Database ──────────────────────────────────────────────────────────────────
# Leave BRAIN_DB_BACKEND unset (or "sqlite") for local SQLite dev mode.
# Set to "postgres" for production — requires DATABASE_URL below.
BRAIN_DB_BACKEND=postgres
#
# Supabase (recommended):
#   1. supabase.com → New project
#   2. Settings → Database → URI (use the pooler URI, port 6543)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Alternative: any Postgres 14+ URI
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Authentication (Clerk) ────────────────────────────────────────────────────
# Required for multi-user / production. Leave blank for single-user bypass mode.
# https://dashboard.clerk.com → your app → API Keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
#
# Development bypass — lets the server start without Clerk in dev only.
# NEVER set to true when BRAIN_ENV=production (server will refuse to start).
BRAIN_DEV_BYPASS=false

# ── Supabase Auth (optional — only if using Supabase Auth alongside Clerk) ───
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=

# ── Environment ───────────────────────────────────────────────────────────────
# "development" (default) — bypass allowed, relaxed checks
# "production"  — bypass forbidden, Clerk key required, HTTPS headers enforced
BRAIN_ENV=production

# ── CORS (production) ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to * in dev.
# ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# ── Connectors ────────────────────────────────────────────────────────────────
# Slack (direct integration):
SLACK_BOT_TOKEN=
#
# Composio (1,000+ apps — Gmail, Notion, GitHub, Jira, Linear, HubSpot…):
# https://app.composio.dev → Settings → API Keys
COMPOSIO_API_KEY=

# ── Platform owner (Intellark team only) ─────────────────────────────────────
# Grants access to /api/_platform/metrics.
# Do NOT set this for customer workspaces.
BRAIN_PLATFORM_OWNER=false

# ── Observability (optional) ──────────────────────────────────────────────────
# Langfuse — LLM tracing and eval: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Advanced tuning (rarely needed) ──────────────────────────────────────────
# BRAIN_WORKSPACE=ws_local        # default workspace ID (single-tenant)
# BRAIN_TEAM=engineering           # default team ID
# BRAIN_USER=you@company.com       # default caller identity
# BRAIN_DB=brain.db                # SQLite filename (sqlite mode only)
# BRAIN_RERANK=true                # enable cross-encoder reranking
# REDIS_URL=redis://localhost:6379 # enable query-result caching
