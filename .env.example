# Thread — environment variable template
# Copy this file to .env and fill in your values.
# Everything runs on Supabase (Postgres) — no local DB.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set exactly ONE key. Auto-detection priority: Grok > Anthropic > OpenAI > Gemini
#
# Gemini (free tier): https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# OpenAI:            https://platform.openai.com → API keys
OPENAI_API_KEY=
# Anthropic:         https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# xAI Grok:          https://console.x.ai → API keys
GROK_API_KEY=

# ── Database (Supabase — required) ───────────────────────────────────────────
# supabase.com → New project → Settings → Database → URI
# Use the pooler URI (port 6543), not the direct connection (port 5432).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=

# ── Authentication (Clerk) ────────────────────────────────────────────────────
# https://dashboard.clerk.com → your app → API Keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Encryption at rest ────────────────────────────────────────────────────────
# Encrypts customer-supplied LLM API keys before they are written to the
# database. Without it those keys are stored in plaintext and the server warns
# on startup. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this value makes existing encrypted keys unreadable — customers would
# need to re-enter them. Back it up somewhere other than the database.
BRAIN_KEY_ENCRYPTION_KEY=

# ── Environment ───────────────────────────────────────────────────────────────
# "development" — bypass allowed, relaxed checks
# "production"  — bypass forbidden, Clerk key required
BRAIN_ENV=development

# Workspace the app serves. Must match the workspace your connectors
# sync into, or the app will query an empty/unrelated knowledge base.
BRAIN_WORKSPACE=ws_demo
# Set true only in local dev — NEVER in production (server refuses to start)
BRAIN_DEV_BYPASS=false

# ── Slack App (optional — for @-mention bot and OAuth) ───────────────────────
# Create app at api.slack.com/apps → OAuth & Permissions + Event Subscriptions
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Bot token (set automatically after OAuth, or paste manually for single-workspace):
SLACK_BOT_TOKEN=

# ── Connectors ────────────────────────────────────────────────────────────────
# Composio (1,000+ apps — Gmail, Notion, GitHub, Linear…):
# https://app.composio.dev → Settings → API Keys
COMPOSIO_API_KEY=

# ── Observability (optional) ──────────────────────────────────────────────────
# Sentry error tracking: https://sentry.io → New Project → Python
SENTRY_DSN=
# Log verbosity: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ── App URL (required in production for invite links) ────────────────────────
# Set to your deployed URL so invite links point to the right place
APP_BASE_URL=https://your-app.vercel.app

# ── Guest / demo access ───────────────────────────────────────────────────────
# Set GUEST_TOKEN_SECRET to enable the "Try live demo" button on the login page.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave unset to disable guest access entirely (button is still shown but returns 503).
GUEST_TOKEN_SECRET=
# Per-session and daily caps to protect your free Gemini quota:
GUEST_SESSION_CAP=20    # queries per browser tab session
GUEST_DAILY_CAP=100     # queries across ALL guest sessions in a rolling 24 h window
# Seed the demo workspace first: python scripts/seed_demo.py

# ── Background polling (connector auto-sync) ─────────────────────────────────
# How often the worker polls all connected apps for new content (minutes).
# Lower = more real-time, higher token usage. Minimum recommended: 5.
BRAIN_POLL_INTERVAL_MINUTES=10

# ── Webhook ingestion (near-real-time push events) ────────────────────────────
# Set this to enable the POST /api/ingest/event endpoint.
# Must match the signing secret configured in your Composio webhook settings.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
COMPOSIO_WEBHOOK_SECRET=

# How often the gap-healing reconcile job runs (minutes). Default 60.
# Catches items missed during circuit opens, timeouts, or rate limits.
BRAIN_RECONCILE_INTERVAL_MINUTES=60

# ── Advanced (rarely needed) ──────────────────────────────────────────────────
# BRAIN_PLATFORM_OWNER=false   # grants /api/_platform/metrics - internal use only
# Redis is OPTIONAL. Leave unset and the app runs normally: the query cache
# becomes a no-op and background jobs fall back to running in a thread.
# Set it to enable query-result caching, and to run the arq worker
# (`arq brain.worker.WorkerSettings`), which adds webhook ingestion and
# per-job retry backoff. Connector sync itself does not need it — that runs
# from .github/workflows/sync.yml via scripts/sync_once.py.
# REDIS_URL=redis://localhost:6379
# BRAIN_LLM_MODEL=             # override auto-detected model
